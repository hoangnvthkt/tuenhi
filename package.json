{
  "name": "tuenhi-pos",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.13.1 <25",
    "pnpm": ">=11.19.0 <12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/verify-production-build.mjs dist",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ci": "E2E_SKIP_CLOUD_LIFECYCLE_CHECK=1 playwright test e2e/app-shell.spec.ts",
    "test:e2e:production": "playwright test --config playwright.production.config.ts",
    "test:e2e:phase1b": "playwright test e2e/catalog-import.spec.ts e2e/legacy-archive.spec.ts",
    "test:e2e:phase1c": "playwright test e2e/inventory-cost.spec.ts",
    "test:e2e:phase1e": "node --env-file=.env node_modules/@playwright/test/cli.js test e2e/phase-1e-returns-stock-count.spec.ts",
    "test:e2e:phase1f": "node --env-file=.env node_modules/@playwright/test/cli.js test e2e/phase-1e-returns-stock-count.spec.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:cloud:phase1a": "node --env-file=.env scripts/phase-1a-cloud-security.mjs",
    "test:cloud:phase1b": "node --env-file=.env scripts/phase-1b-cloud-security.mjs",
    "test:cloud:phase1c": "node --env-file=.env scripts/phase-1c-cloud-security.mjs",
    "test:cloud:phase1e": "node --env-file=.env scripts/phase-1e-cloud-security.mjs",
    "test:cloud:phase1f": "node --env-file=.env scripts/phase-1f-cloud-security.mjs",
    "templates:generate": "node scripts/generate-import-templates.mjs",
    "templates:verify": "node scripts/verify-import-templates.mjs",
    "verify:production-build": "node scripts/verify-production-build.mjs dist",
    "pwa:assets": "pwa-assets-generator --preset minimal-2023 public/logo.svg",
    "bootstrap:owner": "node scripts/bootstrap-owner.mjs",
    "cutover:preflight": "node --env-file=.env scripts/cutover-preflight.mjs",
    "cutover:cleanup-tests": "node --env-file=.env scripts/cutover-cleanup-tests.mjs",
    "cutover:backup": "node --env-file=.env scripts/cutover-backup.mjs",
    "cutover:export-images": "node --env-file=.env scripts/cutover-export-images.mjs",
    "cutover:verify-backup": "node --env-file=.env scripts/cutover-verify-backup.mjs",
    "cutover:verify": "node --env-file=.env scripts/cutover-verify.mjs",
    "cutover:mock-manifest": "node --env-file=.env scripts/cutover-mock-manifest.mjs",
    "cutover:dispose-mock": "node --env-file=.env scripts/cutover-dispose-mock.mjs",
    "cutover:verify-real-data": "node --env-file=.env scripts/cutover-verify-real-data.mjs",
    "cutover:lifecycle": "node --env-file=.env scripts/cutover-lifecycle.mjs",
    "supabase:types": "supabase gen types --linked --lang typescript --schema api > src/shared/supabase/database.types.ts",
    "cloud:verify:phase1a": "supabase db query --linked --file supabase/tests/phase_1a_identity_assertions.sql && supabase db query --linked --file supabase/tests/phase_1a_password_change_assertions.sql && supabase db query --linked --file supabase/tests/phase_1a_notification_assertions.sql && supabase db query --linked --file supabase/tests/phase_1a_staff_assertions.sql",
    "cloud:verify:phase1b": "supabase db query --linked --file supabase/tests/phase_1b_catalog_assertions.sql && supabase db query --linked --file supabase/tests/phase_1b_storage_realtime_assertions.sql && supabase db query --linked --file supabase/tests/phase_1b_import_assertions.sql && supabase db query --linked --file supabase/tests/phase_1b_legacy_assertions.sql",
    "cloud:verify:phase1c": "supabase db query --linked --file supabase/tests/phase_1c_inventory_assertions.sql",
    "cloud:verify:phase1d": "supabase db query --linked --file supabase/tests/phase_1d_sales_assertions.sql",
    "cloud:verify:phase1e": "supabase db query --linked --file supabase/tests/phase_1e_returns_stock_count_assertions.sql",
    "cloud:verify:phase1f": "supabase db query --linked --file supabase/tests/phase_1f_report_assertions.sql && supabase db query --linked --file supabase/tests/phase_1f_b_cutover_assertions.sql && supabase db query --linked --file supabase/tests/phase_1f_b8_command_outcome_assertions.sql",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm templates:verify && pnpm build",
    "check:full": "pnpm check && pnpm test:e2e",
    "supabase": "supabase"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@supabase/supabase-js": "2.112.3",
    "@tanstack/react-query": "5.101.4",
    "exceljs": "4.4.0",
    "libphonenumber-js": "1.13.11",
    "pdfmake": "^0.3.11",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.85.0",
    "react-router": "8.3.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/eslint-plugin-query": "5.101.4",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.5",
    "@types/node": "24.13.3",
    "@types/pdfmake": "^0.3.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vite-pwa/assets-generator": "1.0.2",
    "@vitejs/plugin-react": "6.1.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "globals": "17.11.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "supabase": "2.115.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.2",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.11"
  }
}
